rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agreements/{id} {
      // Je keu notun agreement jomа dite pare
      allow create: if request.resource.data.type in ['client','partner']
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() < 120
                    && request.resource.data.email is string && request.resource.data.email.size() < 160
                    && request.resource.data.hash is string && request.resource.data.hash.size() == 64
                    && request.resource.data.sig is string && request.resource.data.sig.size() < 700000
                    && request.resource.data.get('thumb','').size() < 400000
                    && request.resource.data.get('terms','').size() < 30000
                    && request.resource.data.createdAt == request.time;
      // Link (lomba ottopurbo ID) jar kache ache se ekta agreement dekhte pare, talika dekhte pare na
      allow get: if true;
      // Shudhu admin talika dekhte o status bodlate pare
      allow list: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_HERE';
      allow update: if request.auth != null && request.auth.token.email == 'ADMIN_EMAIL_HERE'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }
  }
}
